# Local Development Environment Variables
# This file is for local development only
# DO NOT commit this file to version control

# Copy from .env.example and fill in your actual values
# cp .env.example .env.local

# =============================================================================
# Quick Start - Minimal Configuration
# =============================================================================

# Choose ONE of the following AI providers:

# Option 1: OpenAI (Recommended for getting started)
OPENAI_API_KEY=sk-...

# Option 2: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# Option 3: OpenCode Zen (Managed service)
# OPENCODE_ZEN_API_KEY=...

# =============================================================================
# Development Settings
# =============================================================================

NODE_ENV=development
LOG_LEVEL=debug
PORT=4096

# =============================================================================
# Optional Settings (uncomment and configure as needed)
# =============================================================================

# GitHub Integration
# GITHUB_TOKEN=ghp_...

# Azure OpenAI
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Database
# DATABASE_URL=file:./opencode.db

# Session
# SESSION_SECRET=change-me-in-production

# =============================================================================
# Notes
# =============================================================================

# 1. At minimum, you need ONE AI provider API key to use OpenCode
# 2. For local development, most other settings have sensible defaults
# 3. See .env.example for complete list of available options
# 4. Never commit API keys or secrets to version control
# 5. Add .env.local to .gitignore (already done)
