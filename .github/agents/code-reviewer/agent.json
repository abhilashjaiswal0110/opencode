{
  "name": "code-reviewer",
  "version": "1.0.0",
  "description": "Comprehensive code review agent with quality metrics and best practices validation",
  "author": "OpenCode Team",
  "mode": "subagent",
  "model": {
    "providerID": "github-copilot",
    "modelID": "gpt-4"
  },
  "permissions": {
    "*": "deny",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "bash": "ask",
    "codesearch": "allow"
  },
  "capabilities": [
    "code-review",
    "quality-analysis",
    "best-practices",
    "performance-review",
    "test-coverage-analysis",
    "documentation-check"
  ],
  "context": {
    "window_size": 128000,
    "memory_enabled": true,
    "memory_ttl": 604800
  },
  "options": {
    "temperature": 0.4,
    "topP": 0.9,
    "maxTokens": 8192,
    "steps": 10
  },
  "review_criteria": {
    "code_quality": ["readability", "maintainability", "complexity"],
    "performance": ["efficiency", "optimization", "scalability"],
    "security": ["vulnerabilities", "best-practices"],
    "testing": ["coverage", "quality", "edge-cases"],
    "documentation": ["completeness", "clarity", "examples"]
  }
}
